/// تشغيل كامل للايجنت المستقل — هدف واحد + خطة + تنفيذ + نتائج
model AgentRun {
  id             String      @id @default(cuid())
  workspaceId    String
  objective      String
  status         String      @default("RUNNING") // RUNNING | SUCCESS | FAILED
  plannedQueries Json? // string[]
  platforms      Json? // string[] — المنصات المختارة
  steps          AgentStep[]
  leadsCreated   Int         @default(0)
  itemsScanned   Int         @default(0)
  memoryHits     Int         @default(0)
  reusedMemory   Boolean     @default(false)
  summary        String?
  errorMessage   String?
  durationMs     Int         @default(0)
  createdById    String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

/// خطوة واحدة داخل تشغيل الأيجنت (نداء أداة أو قرار)
model AgentStep {
  id         String   @id @default(cuid())
  runId      String
  idx        Int
  tool       String
  input      Json?
  output     Json?
  status     String   @default("OK") // OK | FAILED | SKIPPED
  note       String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, idx])
}

/// ذاكرة البحث العامة — "ادور على دورك قبل ما تدور": كل استعلام اتنفذ يتحفظ بنتايجه وجودته
model SearchMemory {
  id              String   @id @default(cuid())
  workspaceId     String
  query           String
  queryHash       String // FNV-1a of normalized query
  normalizedQuery String // keywords sorted
  platform        String   @default("WEB")
  resultCount     Int      @default(0)
  leadCount       Int      @default(0)
  avgScore        Int      @default(0)
  bestScore       Int      @default(0)
  qualityScore    Int      @default(0) // 0-100 — مدى جودة هذا الاستعلام كمنجم ليدز
  provider        String?
  bestResults     Json? // أفضل 10 نتايج مختصرة {title,url,score}
  insights        Json? // ملاحظات مكتسبة
  hitCount        Int      @default(1) // كام مرة اتعاد استخدامه
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, queryHash, platform])
}

/// بصيرة مكتسبة من الأيجنت — بتتحفظ وتتوزن لتحسين التشغيلات الجاية
model AgentInsight {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String // query_pattern | platform_signal | negative | positive | contact_harvest
  pattern     String
  note        String
  evidence    Json?
  weight      Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, weight])
}

// ══════════ Group Monitor — تحدي الجروبات ══════════
// مراقبة جروبات فيسبوك/تليجرام/ريديت/… حيث ينشر الناس طلبات الخدمات،
// مع تصنيف كل بوست للوحة الصحيحة (كروت النت / الأجنسي) وتحويله لعميل.

/// جروب/قناة/مجتمع مراقَب — يُكتشف آليًا أو يُضاف يدويًا
model MonitoredGroup {
  id            String    @id @default(cuid())
  workspaceId   String
  platform      String // GROUP_PLATFORM: FACEBOOK | TELEGRAM | REDDIT | X | OTHER
  name          String
  url           String
  externalId    String // معرّف الجروب / subreddit / معرف القناة
  segment       String    @default("BOTH") // LeadSegment: CARDS | AGENCY | BOTH
  status        String    @default("ACTIVE") // GroupStatus: ACTIVE | PAUSED | NEEDS_SESSION | BLOCKED | ARCHIVED
  statusNote    String?
  membersText   String?
  intentScore   Int       @default(0) // 0-100 — مدى ملاءمة الجروب لخدماتنا
  activityScore Int       @default(0) // 0-100 — نشاط المنشورات الحديثة
  postCount     Int       @default(0)
  lastScannedAt DateTime?
  lastPostAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     GroupPost[]

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, segment, status])
  @@index([lastScannedAt])
}

/// منشور مُلتقط من داخل جروب مراقَب — يُقيَّم ويُصنَّف ويمكن تحويله لعميل
model GroupPost {
  id              String    @id @default(cuid())
  groupId         String
  externalId      String?
  url             String?
  author          String?
  content         String
  postedAt        DateTime?
  detectedAt      DateTime  @default(now())
  score           Int       @default(0) // 0-99 قوة النية
  segment         String    @default("BOTH") // LeadSegment: CARDS | AGENCY | BOTH
  matchedKeywords Json? // string[] الكلمات المفتاحية المطابقة
  status          String    @default("NEW") // PostStatus: NEW | QUALIFIED | REJECTED | CONVERTED
  leadId          String?
  createdAt       DateTime  @default(now())

  group MonitoredGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalId])
  @@index([groupId, detectedAt])
  @@index([status, score])
  @@index([segment, status, detectedAt])
}

// ══════════ زيزو — كيان البيع الذاتي ══════════

/// محادثة زيزو مع عميل على قناة (واتساب/يدوي/منصة)
model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  leadId        String?
  channel       String    @default("MANUAL")
  externalId    String?
  contactName   String?
  contactHandle String?
  lang          String    @default("ar")
  stage         String    @default("NEW")
  status        String    @default("OPEN")
  memo          String?
  lastMsgAt     DateTime  @default(now())
  msgCount      Int       @default(0)
  bookedAt      DateTime?
  bookedNote    String?
  lastReplyBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead               Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages           Message[]
  sequences          Sequence[]
  enrollments        SequenceEnrollment[]
  experiments        AbExperiment[]
  evolutionProposals EvolutionProposal[]
  platformAccounts   PlatformAccount[]
  tacticStats        TacticStat[]
  mode               String?
  progress           String?
  strategy           String?

  @@index([workspaceId, stage, status])
  @@index([workspaceId, lastMsgAt])
  @@index([leadId])
}

/// رسالة داخل محادثة زيزو
model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  author         String
  body           String
  sentAt         DateTime @default(now())
  deliverMs      Int?
  meta           Json?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// ═══ Dynamic Skill Intelligence Layer — طبقة الذكاء الديناميكية (مواصفة 43) ═══
// TaskGraph: خريطة تفكير ديناميكية تُبنى لكل مهمة — مش خطة ثابتة. العقد تتنفذ بالترتيب
// القانوني (dependencies + priority) وتتأكد بالأدلة، وفشل أي مسار = إعادة تخطيط مش موت.
model TaskGraph {
  id          String    @id @default(cuid())
  workspaceId String
  goal        String    @db.Text
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED | FAILED | STOPPED
  trigger     String    @default("AGENT") // AGENT | TOOL | TICK | API | CHAT
  sourceRunId String?
  assumptions Json?
  facts       Json?
  finalResult Json?
  stats       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     TaskGraphNode[]
  events    TaskGraphEvent[]

  @@index([workspaceId, status])
  @@index([updatedAt])
}

// TaskGraphNode: عقدة واحدة بعقد التنفيذ الكامل (43.4) — الحواف جوه dependencies/nextRoutes.
model TaskGraphNode {
  id                   String    @id @default(cuid())
  graphId              String
  graph                TaskGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  nodeId               String
  parentNodeId         String?
  type                 String
  objective            String    @db.Text
  inputRequirements    Json?
  requiredFacts        Json?
  requiredSkills       Json?
  candidateSkills      Json?
  selectedSkills       Json?
  tools                Json?
  dependencies         Json?
  priority             Int       @default(5)
  costEstimate         Int       @default(1)
  riskEstimate         Int       @default(1)
  expectedOutput       String?
  verificationCriteria Json?
  policyGate           String    @default("STANDARD")
  accountRequirement   Json?
  sourceRequirement    Json?
  status               String    @default("PENDING")
  attempts             Int       @default(0)
  outcome              String?
  outcomeData          Json?
  failureReason        String?
  nextRoutes           Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([graphId, nodeId])
  @@index([graphId, status])
}

// TaskGraphEvent: سجل القرارات والأدلة وإعادة التخطيط والبوابات — أسئلة الوعي (43.16).
model TaskGraphEvent {
  id        String    @id @default(cuid())
  graphId   String
  graph     TaskGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  nodeId    String?
  type      String
  message   String    @db.Text
  payload   Json?
  createdAt DateTime  @default(now())

  @@index([graphId, createdAt])
}

// SkillRetrieval: سجل كل عملية استرجاع — المرشحون بدرجاتهم والمختارون بأسبابهم والمرفوضون بسببهم.
model SkillRetrieval {
  id          String   @id @default(cuid())
  workspaceId String
  graphId     String?
  nodeId      String?
  taskId      String?
  objective   String   @default("") @db.Text
  parsed      Json?
  candidates  Json?
  selected    Json?
  rejected    Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([graphId])
}

// SkillOutcome: نتيجة تنفيذ مهارة في عقدة — وقود حلقة التعلم (43.11/43.27).
model SkillOutcome {
  id          String   @id @default(cuid())
  workspaceId String
  skillKind   String
  skillKey    String
  graphId     String?
  nodeId      String?
  taskId      String?
  outcome     String
  quality     Float    @default(0)
  latencyMs   Int      @default(0)
  notes       String   @default("") @db.Text
  createdAt   DateTime @default(now())

  @@index([skillKind, skillKey])
  @@index([workspaceId, createdAt])
}

// LeadOS — تصدير الليدز CSV على الاستضافة: الملف بيتخزن هنا بدل القرص المحلي
// (قرص Vercel م مؤقت/read-only — والتنزيل بيبقى من /api/exports/[token])
model LeadExport {
  id          String   @id @default(cuid())
  workspaceId String
  token       String   @unique @default(cuid())
  filename    String
  csv         String   @db.Text
  leadCount   Int      @default(0)
  minScore    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}
