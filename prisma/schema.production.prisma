  timezone     String   @default("Africa/Cairo")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   WorkspaceMember[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  createdLeads  Lead[]            @relation("LeadCreator")
  activities    Activity[]
  tasks         Task[]
  notes         Note[]
  chatSessions  AiChatSession[]
  auditLogs     AuditLog[]
  alerts        Alert[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  sources            Source[]
  rules              SearchRule[]
  leads              Lead[]
  businesses         Business[]
  researchRuns       ResearchRun[]
  opportunities      Opportunity[]
  pipelines          Pipeline[]
  tags               Tag[]
  savedViews         SavedView[]
  jobs               Job[]
  aiRuns             AiRun[]
  aiConfigs          AiProviderConfig[]
  chatSessions       AiChatSession[]
  automations        Automation[]
  alerts             Alert[]
  auditLogs          AuditLog[]
  contactLists       ContactList[]
  people             Person[]
  activities         Activity[]
  tasks              Task[]
  notes              Note[]
  contents           ContentItem[]
  findings           Finding[]
  deals              Deal[]
  agentRuns          AgentRun[]
  searchMemories     SearchMemory[]
  agentInsights      AgentInsight[]
  monitoredGroups    MonitoredGroup[]
  conversations      Conversation[]
  sequences          Sequence[]
  abExperiments      AbExperiment[]
  evolutionProposals EvolutionProposal[]
  platformAccounts   PlatformAccount[]
  tacticStats        TacticStat[]
  skillStats         SkillStat[]
  skillLessons       SkillLesson[]
  taskGraphs         TaskGraph[]
}

// ═══ عقل المهارات — الإحصاء والتعلم (doc §3) ═══
// SkillStat: وزن كل منصة-مهارة لكل ورشة — أعلى = الـselector بيختارها أكتر
model SkillStat {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String
  runs        Int       @default(0) // عدد الجوبات اللي المهارة دخلتها
  results     Int       @default(0) // عناصر مكتشفة إجمالي
  leads       Int       @default(0) // ليدز اتعملت
  wins        Int       @default(0) // ليدز عالية النية/الدرجة
  weight      Float     @default(1.0)
  lastUsedAt  DateTime?
  lastLeadAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
  @@index([platform])
}

// SkillLesson: ذاكرة الاستعلامات — استعلامات حققت ليدز بتترجع أولًا + استعلامات AI المولّدة
model SkillLesson {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String
  query       String
  niche       String?
  leads       Int       @default(1)
  quality     Float     @default(0) // مجموع درجات الليدز الناتجة
  source      String    @default("learned") // learned | ai
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, query])
  @@index([platform, quality])
}

// GitSkill: مهارة محصودة من قاعدة GitSkills العالمية (3,797,117 ملف SKILL.md على HuggingFace —
// داتابيز MSR'27: كل مهارة مفتوحة على GitHub بصيغة Anthropic). مكتبة عالمية مشتركة (من غير workspace)
// — الحصاد عشوائي موجه بالكلمات المفتاحية، والتعلم بيرفع وزن اللي بيجيب ليدز.
model GitSkill {
  id          String   @id @default(cuid())
  repo        String
  path        String
  name        String
  description String   @default("")
  body        String   @default("") @db.Text // أول ~2500 حرف من توجيهات المهارة
  tags        String   @default("") // كلمات مفتاحية مفصولة بفواصل (منصات + تخصصات)
  relevance   Float    @default(0) // درجة الصلة بالصيد عند الحصاد
  contentHash String   @default("") // بصمة المحتوى — تتغير = إعادة فحص الثقة (43.18)
  trustScore  Int      @default(50) // 0-100 من بوابة الثقة (43.8)
  status      String   @default("ACTIVE") // ACTIVE | REJECTED | BLOCKED | STALE
  license     String   @default("") // رخصة المهارة لو معروفة
  useCount    Int      @default(0) // مرات الدخول في برومبتات الـAI
  leadCount   Int      @default(0) // ليدز نزلت وأنا حاضر في السياق
  weight      Float    @default(1.0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([repo, path])
  @@index([relevance])
  @@index([status])
}

// HubSkill: مهارة منسّقة من مكتبة ClawHub العالمية (clawhub.ai — سجل OpenClaw الرسمي)
// سياسة الاستيراد: «تعليمات فقط» — SKILL.md بيتخزن كنص للـAI، مفيش أي سكريبت بيتنفذ.
// البوابة: isSuspicious لازم تكون false + فحص محتوى (مفيش curl/exec/تسريب مفاتيح).
model HubSkill {
  id          String    @id @default(cuid())
  slug        String    @unique // معرّف المكتبة (owner/slug)
  owner       String    @default("") // ناشر المهارة
  name        String
  summary     String    @default("") // الوصف الرسمي من ClawHub
  body        String    @default("") // أول ~2500 حرف من توجيهات SKILL.md
  tags        String    @default("") // كلمات مفتاحية مفصولة بفواصل (منصات + تخصصات)
  relevance   Float     @default(0) // درجة الصلة بالصيد عند الحصاد
  installs    Int       @default(0) // إحصائيات المكتبة وقت الحصاد
  stars       Int       @default(0)
  downloads   Int       @default(0)
  sourceUrl   String    @default("") // رابط المهارة على clawhub.ai
  contentHash String    @default("") // بصمة المحتوى — تتغير = إعادة فحص الثقة (43.18)
  trustScore  Int       @default(50) // 0-100 من بوابة الثقة (43.8)
  status      String    @default("ACTIVE") // ACTIVE | REJECTED | BLOCKED | STALE
  license     String    @default("") // رخصة المهارة لو معروفة
  useCount    Int       @default(0) // مرات الدخول في برومبتات الـAI
  leadCount   Int       @default(0) // ليدز نزلت وأنا حاضر في السياق
  weight      Float     @default(1.0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([relevance])
  @@index([weight])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Source {
  id             String       @id @default(cuid())
  workspaceId    String
  type           SourceType
  name           String
  status         SourceStatus @default(ACTIVE)
  config         Json?
  credentialsRef String? // Reference to secret manager, never store API keys here.
  scheduleCron   String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents   ContentItem[]
  searchJobs SearchJob[]

  @@index([workspaceId, type, status])
  @@index([nextRunAt])
}

model SearchJob {
  id              String    @id @default(cuid())
  sourceId        String
  searchRuleId    String?
  query           String
  normalizedQuery String?
  startedAt       DateTime?
  completedAt     DateTime?
  status          JobStatus @default(QUEUED)
  resultCount     Int       @default(0)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  searchRule SearchRule? @relation(fields: [searchRuleId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model SearchRule {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  enabled       Boolean       @default(true)
  priority      Int           @default(100)
  countries     String[]      @default([])
  cities        String[]      @default([])
  industries    String[]      @default([])
  services      String[]      @default([])
  keywords      String[]      @default([])
  excludedWords String[]      @default([])
  sourceTypes   SourceType[]  @default([])
  minLeadScore  Int           @default(0)
  scheduleCron  String?
  startResearch Boolean       @default(true)
  researchDepth ResearchDepth @default(DEEP)
  config        Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searches  SearchJob[]
  actions   SearchRuleAction[]

  @@index([workspaceId, enabled, priority])
}

model SearchRuleAction {
  id           String         @id @default(cuid())
  searchRuleId String
  type         RuleActionType
  value        Json?
  order        Int            @default(0)

  searchRule SearchRule @relation(fields: [searchRuleId], references: [id], onDelete: Cascade)

  @@index([searchRuleId, order])
}

model ContentItem {
  id             String        @id @default(cuid())
  workspaceId    String
  sourceId       String
  externalId     String?
  canonicalUrl   String?
  parentUrl      String?
  authorName     String?
  authorHandle   String?
  title          String?
  body           String?
  contentType    ContentType
  status         ContentStatus @default(NEW)
  publishedAt    DateTime?
  collectedAt    DateTime      @default(now())
  language       String?
  rawData        Json?
  normalizedData Json?
  contentHash    String?
  embedding      Json?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  leadLinks LeadContent[]
  findings  Finding[]

  @@unique([sourceId, externalId])
  @@index([workspaceId, status, collectedAt])
  @@index([contentHash])
  @@index([publishedAt])
}

model Business {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  legalName     String?
  category      String?
  industry      String?
  description   String?
  country       String?
  city          String?
  region        String?
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  phone         String?
  email         String?
  websiteUrl    String?
  mapsUrl       String?
  mapsPlaceId   String?
  rating        Decimal? @db.Decimal(3, 2)
  reviewCount   Int?
  openingHours  Json?
  employeeCount Int?
  foundedYear   Int?
  status        String?
  metadata      Json?
  embedding     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads           Lead[]
  branches        Branch[]
  websites        Website[]
  socialProfiles  SocialProfile[]
  reviews         Review[]
  businessSources BusinessSource[]
  opportunities   Opportunity[]
  people          Person[]
  competitors     Competitor[]     @relation("BusinessCompetitor")
  competitorOf    Competitor[]     @relation("CompetitorBusiness")

  @@unique([workspaceId, mapsPlaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, city, category])
}

model Branch {
  id          String   @id @default(cuid())
  businessId  String
  name        String?
  address     String?
  city        String?
  region      String?
  country     String?
  phone       String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  mapsPlaceId String?
  mapsUrl     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([mapsPlaceId])
}

model BusinessSource {
  id          String     @id @default(cuid())
  businessId  String
  sourceType  SourceType
  sourceUrl   String?
  externalId  String?
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  rawData     Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceType, externalId])
  @@index([businessId, sourceType])
}

model Website {
  id               String    @id @default(cuid())
  businessId       String
  url              String
  normalizedUrl    String?
  title            String?
  description      String?
  language         String?
  cms              String?
  technologies     String[]  @default([])
  analyticsTools   String[]  @default([])
  performanceScore Int?
  mobileScore      Int?
  seoScore         Int?
  uxScore          Int?
  sslValid         Boolean?
  hasWhatsapp      Boolean?
  hasBooking       Boolean?
  hasOrdering      Boolean?
  hasEcommerce     Boolean?
  crawledAt        DateTime?
  auditData        Json?
  embedding        Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

