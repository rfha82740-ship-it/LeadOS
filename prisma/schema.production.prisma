  temperature     LeadTemperature @default(UNKNOWN)
  intent          IntentLevel     @default(UNKNOWN)
  segment         String          @default("AGENCY") // LeadSegment: CARDS | AGENCY | BOTH
  leadSourceType  LeadSourceType
  sourcePlatform  String?   // المنصة من الـ16 (PLATFORM_SITES) — فلتر لوحة التحكم
  intentSignal    String?   // EXPLICIT_NEED | COMPETITOR_ENGAGER | AD_SPENDER | MARKET_LIST
  score           Int             @default(0)
  intentScore     Int             @default(0)
  fitScore        Int             @default(0)
  urgencyScore    Int             @default(0)
  confidenceScore Int             @default(0)
  serviceNeeds    String[]        @default([])
  painPoints      String[]        @default([])
  summary         String?
  whyNow          String?
  nextBestAction  String?
  firstSeenAt     DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  lostReason      String?
  metadata        Json?
  embedding       Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business            Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  person              Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  assignedTo          User?                @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contentLinks        LeadContent[]
  researchRuns        ResearchRun[]
  findings            Finding[]
  opportunities       Opportunity[]
  activities          Activity[]
  tasks               Task[]
  notes               Note[]
  tags                LeadTag[]
  sourceLinks         LeadSource[]
  deals               Deal[]
  conversations       Conversation[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([workspaceId, status, score])
  @@index([workspaceId, leadSourceType, createdAt])
  @@index([workspaceId, sourcePlatform])
  @@index([workspaceId, intentSignal])
  @@index([workspaceId, segment, score])
  @@index([workspaceId, temperature, intent])
  @@index([assignedToId, status])
  @@index([nextFollowUpAt])
}

