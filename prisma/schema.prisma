// AI Lead Intelligence Platform — LeadOS
// SQLite-compatible schema (dev/sandbox). 
// Production schema (PostgreSQL for Neon/Vercel): prisma/schema.production.prisma
// Transformations vs production: enums->String, String[]->Json, Decimal->Float

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("AGENT") // UserRole
  timezone     String   @default("Africa/Cairo")
  isActive     Boolean  @default(true)
  passwordChangedAt DateTime? // آخر تغيير كلمة مرور — الجلسات الأقدم منها تلغى
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   WorkspaceMember[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  createdLeads  Lead[]            @relation("LeadCreator")
  activities    Activity[]
  tasks         Task[]
  notes         Note[]
  chatSessions  AiChatSession[]
  auditLogs     AuditLog[]
  alerts        Alert[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  sources         Source[]
  rules           SearchRule[]
  contents        ContentItem[]
  leads           Lead[]
  businesses      Business[]
  researchRuns    ResearchRun[]
  findings        Finding[]
  opportunities   Opportunity[]
  pipelines       Pipeline[]
  deals           Deal[]
  tags            Tag[]
  savedViews      SavedView[]
  jobs            Job[]
  aiRuns          AiRun[]
  aiConfigs       AiProviderConfig[]
  chatSessions    AiChatSession[]
  automations     Automation[]
  alerts          Alert[]
  auditLogs       AuditLog[]
  contactLists    ContactList[]
  people          Person[]
  activities      Activity[]
  tasks           Task[]
  notes           Note[]
  agentRuns       AgentRun[]
  searchMemories  SearchMemory[]
  agentInsights   AgentInsight[]
  monitoredGroups MonitoredGroup[]
  conversations   Conversation[]
  sequences       Sequence[]
  experiments     AbExperiment[]
  platformAccounts PlatformAccount[]
  tacticStats     TacticStat[]
  evolutionProposals EvolutionProposal[]
  skillStats      SkillStat[]
  skillLessons    SkillLesson[]
  taskGraphs      TaskGraph[]
  workspaceSkills WorkspaceSkill[]
}

// ═══ عقل المهارات — الإحصاء والتعلم (doc §3) ═══
// SkillStat: وزن كل منصة-مهارة لكل ورشة — أعلى = الـselector بيختارها أكتر
// التعلم: ليد جديد → weight يزيد؛ جوبات بدون نتايج → الوزن بيهدّي ببطء
model SkillStat {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String
  runs        Int       @default(0) // عدد الجوبات اللي المهارة دخلتها
  results     Int       @default(0) // عناصر مكتشفة إجمالي
  leads       Int       @default(0) // ليدز اتعملت
  wins        Int       @default(0) // ليدز عالية النية/الدرجة
  weight      Float     @default(1.0)
  lastUsedAt  DateTime?
  lastLeadAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
  @@index([platform])
}

// SkillLesson: ذاكرة الاستعلامات — استعلامات حققت ليدز بتترجع أولًا + استعلامات AI المولّدة
model SkillLesson {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String
  query       String
  niche       String?
  leads       Int       @default(1)
  quality     Float     @default(0) // مجموع درجات الليدز الناتجة
  source      String    @default("learned") // learned | ai
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, query])
  @@index([platform, quality])
}

// GitSkill: مهارة محصودة من قاعدة GitSkills العالمية (3,797,117 ملف SKILL.md على HuggingFace —
// داتابيز MSR'27: كل مهارة مفتوحة على GitHub بصيغة Anthropic). مكتبة عالمية مشتركة (من غير workspace)
// — الحصاد عشوائي موجه بالكلمات المفتاحية، والتعلم بيرفع وزن اللي بيجيب ليدز.
model GitSkill {
  id          String   @id @default(cuid())
  repo        String
  path        String
  name        String
  description String   @default("")
  body        String   @default("") // أول ~2500 حرف من توجيهات المهارة
  tags        String   @default("") // كلمات مفتاحية مفصولة بفواصل (منصات + تخصصات)
  relevance   Float    @default(0) // درجة الصلة بالصيد عند الحصاد
  contentHash String   @default("") // بصمة المحتوى — تتغير = إعادة فحص الثقة (43.18)
  trustScore  Int      @default(50) // 0-100 من بوابة الثقة (43.8)
  status      String   @default("ACTIVE") // ACTIVE | REJECTED | BLOCKED | STALE
  license     String   @default("") // رخصة المهارة لو معروفة
  useCount    Int      @default(0) // مرات الدخول في برومبتات الـAI
  leadCount   Int      @default(0) // ليدز نزلت وأنا حاضر في السياق
  weight      Float    @default(1.0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([repo, path])
  @@index([relevance])
  @@index([status])
}

// HubSkill: مهارة منسّقة من مكتبة ClawHub العالمية (clawhub.ai — سجل OpenClaw الرسمي)
// سياسة الاستيراد: «تعليمات فقط» — SKILL.md بيتخزن كنص للـAI، مفيش أي سكريبت بيتنفذ.
// البوابة: isSuspicious لازم تكون false + فحص محتوى (مفيش curl/exec/تسريب مفاتيح).
model HubSkill {
  id          String    @id @default(cuid())
  slug        String    @unique // معرّف المكتبة (owner/slug)
  owner       String    @default("") // ناشر المهارة
  name        String
  summary     String    @default("") // الوصف الرسمي من ClawHub
  body        String    @default("") // أول ~2500 حرف من توجيهات SKILL.md
  tags        String    @default("") // كلمات مفتاحية مفصولة بفواصل (منصات + تخصصات)
  relevance   Float     @default(0) // درجة الصلة بالصيد عند الحصاد
  installs    Int       @default(0) // إحصائيات المكتبة وقت الحصاد
  stars       Int       @default(0)
  downloads   Int       @default(0)
  sourceUrl   String    @default("") // رابط المهارة على clawhub.ai
  contentHash String    @default("") // بصمة المحتوى — تتغير = إعادة فحص الثقة (43.18)
  trustScore  Int       @default(50) // 0-100 من بوابة الثقة (43.8)
  status      String    @default("ACTIVE") // ACTIVE | REJECTED | BLOCKED | STALE
  license     String    @default("") // رخصة المهارة لو معروفة
  useCount    Int       @default(0) // مرات الدخول في برومبتات الـAI
  leadCount   Int       @default(0) // ليدز نزلت وأنا حاضر في السياق
  weight      Float     @default(1.0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([relevance])
  @@index([weight])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // WorkspaceRole
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Source {
  id             String    @id @default(cuid())
  workspaceId    String
  type           String // SourceType
  name           String
  status         String    @default("ACTIVE") // SourceStatus
  config         Json?
  credentialsRef String?
  scheduleCron   String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents   ContentItem[]
  searchJobs SearchJob[]

  @@index([workspaceId, type, status])
  @@index([nextRunAt])
}

model SearchJob {
  id              String    @id @default(cuid())
  sourceId        String
  searchRuleId    String?
  query           String
  normalizedQuery String?
  startedAt       DateTime?
  completedAt     DateTime?
  status          String    @default("QUEUED") // JobStatus
  resultCount     Int       @default(0)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  searchRule SearchRule? @relation(fields: [searchRuleId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model SearchRule {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  enabled       Boolean  @default(true)
  priority      Int      @default(100)
  countries     Json? // String[]
  cities        Json? // String[]
  industries    Json? // String[]
  services      Json? // String[]
  keywords      Json? // String[]
  excludedWords Json? // String[]
  sourceTypes   Json? // SourceType[]
  minLeadScore  Int      @default(0)
  scheduleCron  String?
  startResearch Boolean  @default(true)
  researchDepth String   @default("DEEP") // ResearchDepth
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searches  SearchJob[]
  actions   SearchRuleAction[]

  @@index([workspaceId, enabled, priority])
}

model SearchRuleAction {
  id           String @id @default(cuid())
  searchRuleId String
  type         String // RuleActionType
  value        Json?
  order        Int    @default(0)

  searchRule SearchRule @relation(fields: [searchRuleId], references: [id], onDelete: Cascade)

  @@index([searchRuleId, order])
}

model ContentItem {
  id             String    @id @default(cuid())
  workspaceId    String
  sourceId       String
  externalId     String?
  canonicalUrl   String?
  parentUrl      String?
  authorName     String?
  authorHandle   String?
  title          String?
  body           String?
  contentType    String    @default("OTHER") // ContentType
  status         String    @default("NEW") // ContentStatus
  publishedAt    DateTime?
  collectedAt    DateTime  @default(now())
  language       String?
  rawData        Json?
  normalizedData Json?
  contentHash    String?
  embedding      Json?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  leadLinks LeadContent[]
  findings  Finding[]

  @@unique([sourceId, externalId])
  @@index([workspaceId, status, collectedAt])
  @@index([contentHash])
  @@index([publishedAt])
}

model Business {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  legalName     String?
  category      String?
  industry      String?
  description   String?
  country       String?
  city          String?
  region        String?
  address       String?
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  websiteUrl    String?
  mapsUrl       String?
  mapsPlaceId   String?
  rating        Float?
  reviewCount   Int?
  openingHours  Json?
  employeeCount Int?
  foundedYear   Int?
  status        String?
  metadata      Json?
  embedding     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads           Lead[]
  branches        Branch[]
  websites        Website[]
  socialProfiles  SocialProfile[]
  reviews         Review[]
  businessSources BusinessSource[]
  opportunities   Opportunity[]
  people          Person[]
  competitors     Competitor[]     @relation("BusinessCompetitor")
  competitorOf    Competitor[]     @relation("CompetitorBusiness")

  @@unique([workspaceId, mapsPlaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, city, category])
}

model Branch {
  id          String   @id @default(cuid())
  businessId  String
  name        String?
  address     String?
  city        String?
  region      String?
  country     String?
  phone       String?
  latitude    Float?
  longitude   Float?
  mapsPlaceId String?
  mapsUrl     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([mapsPlaceId])
}

model BusinessSource {
  id          String   @id @default(cuid())
  businessId  String
  sourceType  String // SourceType
  sourceUrl   String?
  externalId  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  rawData     Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceType, externalId])
  @@index([businessId, sourceType])
}

model Website {
  id               String    @id @default(cuid())
  businessId       String
  url              String
  normalizedUrl    String?
  title            String?
  description      String?
  language         String?
  cms              String?
  technologies     Json? // String[]
  analyticsTools   Json? // String[]
  performanceScore Int?
  mobileScore      Int?
  seoScore         Int?
  uxScore          Int?
  sslValid         Boolean?
  hasWhatsapp      Boolean?
  hasBooking       Boolean?
  hasOrdering      Boolean?
  hasEcommerce     Boolean?
  crawledAt        DateTime?
  auditData        Json?
  embedding        Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pages    WebsitePage[]

  @@index([businessId])
}

model WebsitePage {
  id          String   @id @default(cuid())
  websiteId   String
  url         String
  path        String?
  title       String?
  content     String?
  contentHash String?
  statusCode  Int?
  wordCount   Int?
  crawledAt   DateTime @default(now())
  metadata    Json?
  embedding   Json?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, url])
  @@index([websiteId, crawledAt])
}

model SocialProfile {
  id             String    @id @default(cuid())
  businessId     String
  sourceType     String // SourceType
  profileUrl     String
  handle         String?
  displayName    String?
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  lastActivityAt DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceType, profileUrl])
  @@index([sourceType, handle])
}

model Review {
  id             String    @id @default(cuid())
  businessId     String
  sourceType     String    @default("GOOGLE_MAPS") // SourceType
  externalId     String?
  authorName     String?
  rating         Int?
  text           String?
  publishedAt    DateTime?
  sentiment      String?
  sentimentScore Float?
  topics         Json? // String[]
  painPoints     Json? // String[]
  rawData        Json?
  createdAt      DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceType, externalId])
  @@index([businessId, publishedAt])
  @@index([businessId, sentiment])
}

model Person {
  id              String   @id @default(cuid())
  workspaceId     String
  businessId      String?
  firstName       String?
  lastName        String?
  fullName        String?
  jobTitle        String?
  seniority       String?
  email           String?
  phone           String?
  whatsapp        String?
  linkedinUrl     String?
  location        String?
  isDecisionMaker Boolean?
  confidence      String   @default("UNKNOWN") // ConfidenceLevel
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  leads     Lead[]

  @@index([workspaceId, fullName])
  @@index([businessId, jobTitle])
}

model Lead {
  id              String    @id @default(cuid())
  workspaceId     String
  businessId      String?
  personId        String?
  assignedToId    String?
  createdById     String?
  status          String    @default("NEW") // LeadStatus
  temperature     String    @default("UNKNOWN") // LeadTemperature
  intent          String    @default("UNKNOWN") // IntentLevel
  segment         String    @default("AGENCY") // LeadSegment: CARDS | AGENCY | BOTH
  leadSourceType  String // LeadSourceType
  sourcePlatform  String?   // المنصة من الـ16 (PLATFORM_SITES) — فلتر لوحة التحكم
  intentSignal    String?   // EXPLICIT_NEED | COMPETITOR_ENGAGER | AD_SPENDER | MARKET_LIST
  score           Int       @default(0)
  intentScore     Int       @default(0)
  fitScore        Int       @default(0)
  urgencyScore    Int       @default(0)
  confidenceScore Int       @default(0)
  serviceNeeds    Json? // String[]
  painPoints      Json? // String[]
  summary         String?
  whyNow          String?
  nextBestAction  String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  lostReason      String?
  metadata        Json?
  embedding       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  person        Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contentLinks  LeadContent[]
  researchRuns  ResearchRun[]
  findings      Finding[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
  notes         Note[]
  tags          LeadTag[]
  sourceLinks   LeadSource[]
  deals         Deal[]
  conversations Conversation[]
  enrollments   SequenceEnrollment[]

  @@index([workspaceId, status, score])
  @@index([workspaceId, leadSourceType, createdAt])
  @@index([workspaceId, sourcePlatform])
  @@index([workspaceId, intentSignal])
  @@index([workspaceId, segment, score])
  @@index([workspaceId, temperature, intent])
  @@index([assignedToId, status])
  @@index([nextFollowUpAt])
}

model LeadContent {
  id             String   @id @default(cuid())
  leadId         String
  contentId      String
  relationship   String?
  relevanceScore Int?
  createdAt      DateTime @default(now())

  lead    Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([leadId, contentId])
  @@index([contentId])
}

model LeadSource {
  id          String   @id @default(cuid())
  leadId      String
  sourceType  String // SourceType
  sourceUrl   String?
  label       String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  metadata    Json?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, sourceType])
}

model ResearchRun {
  id                  String    @id @default(cuid())
  workspaceId         String
  leadId              String
  depth               String // ResearchDepth
  status              String    @default("PENDING") // ResearchStatus
  requestedById       String?
  startedAt           DateTime?
  completedAt         DateTime?
  progress            Int       @default(0)
  summary             String?
  whyNow              String?
  recommendedServices Json? // String[]
  scoreBefore         Int?
  scoreAfter          Int?
  config              Json?
  errorMessage        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  findings  Finding[]

  @@index([workspaceId, status, createdAt])
  @@index([leadId, createdAt])
}

model Finding {
  id              String    @id @default(cuid())
  workspaceId     String
  researchRunId   String?
  leadId          String?
  contentId       String?
  type            String // FindingType
  category        String?
  title           String
  statement       String
  normalizedValue String?
  confidence      String    @default("UNKNOWN") // ConfidenceLevel
  confidenceScore Int       @default(0)
  sourceUrl       String?
  evidenceQuote   String?
  observedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, createdAt])
  @@index([leadId, type])
  @@index([researchRunId])
}

model Opportunity {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String?
  businessId  String?
  service     String
  title       String
  description String?
  score       Int      @default(0)
  confidence  Int      @default(0)
  status      String   @default("OPEN") // OpportunityStatus
  reason      String?
  whyNow      String?
  evidence    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  deals     Deal[]

  @@index([workspaceId, status, score])
  @@index([leadId, status])
}

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId])
}

model PipelineStage {
  id          String  @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int?
  color       String?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id              String    @id @default(cuid())
  workspaceId     String
  leadId          String?
  opportunityId   String?
  pipelineId      String
  stageId         String
  title           String
  value           Float?
  currency        String    @default("EGP")
  status          String    @default("OPEN") // DealStatus
  expectedCloseAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, updatedAt])
  @@index([pipelineId, stageId])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String?
  userId      String?
  type        String // InteractionType
  subject     String?
  body        String?
  occurredAt  DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model Task {
  id           String    @id @default(cuid())
  workspaceId  String
  leadId       String?
  assignedToId String?
  title        String
  description  String?
  status       String    @default("TODO") // TaskStatus
  dueAt        DateTime?
  completedAt  DateTime?
  priority     Int       @default(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([workspaceId, dueAt, status])
}

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  userId      String?
  body        String
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     LeadTag[]

  @@unique([workspaceId, name])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  entity      String   @default("lead")
  filters     Json
  sort        Json?
  columns     Json?
  isShared    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entity])
}

model ContactList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  filters     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Competitor {
  id           String   @id @default(cuid())
  businessId   String
  competitorId String
  relationship String?
  evidence     Json?
  createdAt    DateTime @default(now())

  business   Business @relation("BusinessCompetitor", fields: [businessId], references: [id], onDelete: Cascade)
  competitor Business @relation("CompetitorBusiness", fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([businessId, competitorId])
  @@index([competitorId])
}

model AiProviderConfig {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String   @default("MISTRAL") // AiProvider
  model       String
  purpose     String? // AiRunType
  isDefault   Boolean  @default(false)
  baseUrl     String?
  secretRef   String?
  maxTokens   Int?
  temperature Float?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiRuns    AiRun[]

  @@index([workspaceId, provider, isDefault])
}

model AiRun {
  id            String   @id @default(cuid())
  workspaceId   String
  configId      String?
  type          String // AiRunType
  provider      String
  model         String
  leadId        String?
  researchRunId String?
  jobId         String?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Float?
  latencyMs     Int?
  success       Boolean  @default(true)
  errorMessage  String?
  inputRef      String?
  outputRef     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  config    AiProviderConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, provider, model, createdAt])
  @@index([leadId])
}

model AiChatSession {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String?
  context     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  AiChatMessage[]

  @@index([workspaceId, updatedAt])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  toolCalls Json?
  metadata  Json?
  createdAt DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Job {
  id           String    @id @default(cuid())
  workspaceId  String
  type         String // JobType
  status       String    @default("QUEUED") // JobStatus
  priority     Int       @default(50)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime?
  workerId     String?
  payload      Json
  result       Json?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, priority, scheduledAt])
  @@index([status, scheduledAt])
}

model Automation {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  enabled         Boolean  @default(true)
  trigger         String // AutomationTrigger
  conditions      Json?
  actionType      String // AutomationActionType
  actionConfig    Json?
  throttleSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, trigger])
}

model Alert {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  type        String
  title       String
  message     String
  severity    String   @default("INFO")
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isRead, createdAt])
  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

// ══════════ Agent Layer — الذاكرة والأداة الذكية ══════════

/// جلسة تشغيل للأيجنت الداخلي: هدف واحد + خطوات موثقة + نتيجة
model AgentRun {
  id             String      @id @default(cuid())
  workspaceId    String
  objective      String
  status         String      @default("RUNNING") // RUNNING | SUCCESS | FAILED | STOPPED
  mode           String      @default("SCRIPTED") // SCRIPTED | ENTITY — الكيان المستقل
  progress       Int         @default(0) // تقدم ذاتي يبلغ عنه الكيان (0-100)
  strategy       Json? // ملاحظات الاستراتيجية المتطورة من تأملات الكيان
  plannedQueries Json? // string[]
  platforms      Json? // string[] — المنصات المختارة
  steps          AgentStep[]
  leadsCreated   Int         @default(0)
  itemsScanned   Int         @default(0)
  memoryHits     Int         @default(0)
  reusedMemory   Boolean     @default(false)
  summary        String?
  errorMessage   String?
  durationMs     Int         @default(0)
  createdById    String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

/// خطوة واحدة داخل تشغيل الأيجنت (نداء أداة أو قرار)
model AgentStep {
  id         String   @id @default(cuid())
  runId      String
  idx        Int
  tool       String
  input      Json?
  output     Json?
  status     String   @default("OK") // OK | FAILED | SKIPPED
  note       String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, idx])
}

/// ذاكرة البحث العامة — "ادور على دورك قبل ما تدور": كل استعلام اتنفذ يتحفظ بنتايجه وجودته
model SearchMemory {
  id              String   @id @default(cuid())
  workspaceId     String
  query           String
  queryHash       String // FNV-1a of normalized query
  normalizedQuery String // keywords sorted
  platform        String   @default("WEB")
  resultCount     Int      @default(0)
  leadCount       Int      @default(0)
  avgScore        Int      @default(0)
  bestScore       Int      @default(0)
  qualityScore    Int      @default(0) // 0-100 — مدى جودة هذا الاستعلام كمنجم ليدز
  provider        String?
  bestResults     Json? // أفضل 10 نتايج مختصرة {title,url,score}
  insights        Json? // ملاحظات مكتسبة
  embedding       Json? // متجه دلالي (NVIDIA nemotron-3-embed) للبحث المعنوي في الذاكرة
  hitCount        Int      @default(1) // كام مرة اتعاد استخدامه
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, queryHash, platform])
  @@index([workspaceId, qualityScore])
  @@index([workspaceId, lastUsedAt])
}

/// ذاكرة الاستنتاجات — أنماط تعلمها الأيجنت (استعلامات/منصات/أنماط رفض)
model AgentInsight {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String // query_pattern | platform_signal | negative | positive | contact_harvest
  pattern     String
  note        String
  evidence    Json?
  weight      Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, weight])
}

// ══════════ Group Monitor — تحدي الجروبات ══════════
// مراقبة جروبات فيسبوك/تليجرام/ريديت/… حيث ينشر الناس طلبات الخدمات،
// مع تصنيف كل بوست للوحة الصحيحة (كروت النت / الأجنسي) وتحويله لعميل.

/// جروب/قناة/مجتمع مراقَب — يُكتشف آليًا أو يُضاف يدويًا
model MonitoredGroup {
  id            String    @id @default(cuid())
  workspaceId   String
  platform      String // GROUP_PLATFORM: FACEBOOK | TELEGRAM | REDDIT | X | OTHER
  name          String
  url           String
  externalId    String // معرّف الجروب / subreddit / معرف القناة
  segment       String    @default("BOTH") // LeadSegment: CARDS | AGENCY | BOTH
  status        String    @default("ACTIVE") // GroupStatus: ACTIVE | PAUSED | NEEDS_SESSION | BLOCKED | ARCHIVED
  statusNote    String?
  membersText   String?
  intentScore   Int       @default(0) // 0-100 — مدى ملاءمة الجروب لخدماتنا
  activityScore Int       @default(0) // 0-100 — نشاط المنشورات الحديثة
  postCount     Int       @default(0)
  lastScannedAt DateTime?
  lastPostAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     GroupPost[]

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, segment, status])
  @@index([lastScannedAt])
}

/// منشور مُلتقط من داخل جروب مراقَب — يُقيَّم ويُصنَّف ويمكن تحويله لعميل
model GroupPost {
  id              String    @id @default(cuid())
  groupId         String
  externalId      String?
  url             String?
  author          String?
  content         String
  postedAt        DateTime?
  detectedAt      DateTime  @default(now())
  score           Int       @default(0) // 0-99 قوة النية
  segment         String    @default("BOTH") // LeadSegment: CARDS | AGENCY | BOTH
  matchedKeywords Json? // string[] الكلمات المفتاحية المطابقة
  status          String    @default("NEW") // PostStatus: NEW | QUALIFIED | REJECTED | CONVERTED
  leadId          String?
  createdAt       DateTime  @default(now())

  group MonitoredGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalId])
  @@index([groupId, detectedAt])
  @@index([status, score])
  @@index([segment, status, detectedAt])
}

// ══════════ زيزو — كيان البيع الذاتي ══════════
// محادثات زيزو مع العملاء (إنبوكس) — كل محادثة مرتبطة بليد اختياريًا

/// محادثة زيزو مع عميل على قناة (واتساب/يدوي/منصة)
model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  leadId        String?
  channel       String    @default("MANUAL") // CONV_CHANNEL: WHATSAPP | MANUAL | FACEBOOK | INSTAGRAM | WEB | TELEGRAM
  externalId    String? // معرف الشات على المنصة (chat id واتساب مثلًا)
  contactName   String?
  contactHandle String? // رقم/يوزر العميل
  lang          String    @default("ar") // ar | en — لغة العميل المكتشفة
  stage         String    @default("NEW") // SALE_STAGE: NEW | ENGAGED | INTERESTED | OFFERED | OBJECTION | CALL_BOOKED | LOST
  status        String    @default("OPEN") // CONV_STATUS: OPEN | WAITING_CLIENT | NEEDS_REPLY | CLOSED | WON
  memo          String? // ذاكرة زيزو عن العميل (اسمه، شغله، حاجته، ملاحظات شخصية)
  lastMsgAt     DateTime  @default(now())
  msgCount      Int       @default(0)
  bookedAt      DateTime? // ميعاد اللّايف كول المحجوز
  bookedNote    String? // تفاصيل الموعد (اليوم/الساعة كما اتفقوا)
  lastReplyBy   String? // ZIZO | CLIENT | HUMAN_AGENT — آخر من رد
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([workspaceId, stage, status])
  @@index([workspaceId, lastMsgAt])
  @@index([leadId])
}

/// رسالة داخل محادثة زيزو
model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String // IN | OUT
  author         String // CLIENT | ZIZO | HUMAN_AGENT
  body           String
  sentAt         DateTime @default(now())
  deliverMs      Int? // التأخير البشري المطبّق قبل الإرسال (ms)
  meta           Json? // بيانات القناة (messageId واتساب، حالة التسليم…)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// ══════════ الموجة الجديدة: سلاسل المتابعة + تجارب الرسايل + حسابات المنصات ══════════

/// سلسلة متابعة متعددة اللمسات (طلب: 80% من الصفقات بعد 3-5 لمسات)
/// kind: NURTURE (ليدز جديدة) | REACTIVATION (ليدز باردة) | ONBOARD (عملاء جدد)
/// الرسايل بتتولد كمهام جاهزة بإرسال بضغطة — سياسة الرد-فقط: مفيش إرسال آلي استباقي
model Sequence {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  kind           String   @default("NURTURE") // NURTURE | REACTIVATION | ONBOARD
  enabled        Boolean  @default(true)
  targetStatuses Json?    // string[] — حالات الليد المطلوب تجنيدها (فاضي = الكل)
  steps          SequenceStep[]
  enrollments    SequenceEnrollment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, kind])
}

/// خطوة في السلسلة — نص جاهز مكتوب بالعامية + مهلة انتظار بعد الخطوة السابقة
model SequenceStep {
  id         String  @id @default(cuid())
  sequenceId String
  order      Int     @default(1)
  channel    String  @default("TASK") // TASK | WHATSAPP | EMAIL | MANUAL
  template   String
  waitHours  Int     @default(72)
  active     Boolean @default(true)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, order])
}

/// تجنيد ليد في سلسلة — المحرك بيكمل الخطوات لحد ما تخلص أو الليد يرد
model SequenceEnrollment {
  id          String    @id @default(cuid())
  workspaceId String
  sequenceId  String
  leadId      String
  currentStep Int       @default(0)
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED | CANCELLED
  nextStepAt  DateTime?
  lastStepAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, leadId])
  @@index([workspaceId, status, nextStepAt])
  @@index([leadId])
}

/// تجربة A/B على رسايل التواصل — نفس الليد نصفين برسالتين، والفائز يبقى القالب
model AbExperiment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  variants    Json     // [{ name, template, sent, replied, won }]
  status      String   @default("RUNNING") // RUNNING | DONE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// إحصائيات التكتيكات النفسية — محرك التطور الذاتي بيتعلم أيها يكسب ويعيد الأوزان لوحده
/// family: comment (تعليقات الرادار) | reply (ردود المحادثات) | opener (افتتاحيات المبادرات)
model TacticStat {
  id          String    @id @default(cuid())
  workspaceId String
  family      String // comment | reply | opener
  tacticId    String // معرف التكتيك (مثل comment:curiosity_information_gap أو objection:price_investment_reframe)
  used        Int       @default(0)
  wins        Int       @default(0)
  weight      Float     @default(1.0) // الوزن المحسوب — أعلى = اختيار أكتر
  lastUsedAt  DateTime?
  lastWinAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, family, tacticId])
  @@index([workspaceId, family])
}

/// مقترح تطور جوهري — النظام ممنوع يطبقه من غير موافقة صاحب الوكالة (إشعار أولاً ثم تنفيذ بعد الموافقة)
/// kind: STRATEGY | CAPACITY | IDENTITY | FEATURE | TEMPLATE_FAMILY
model EvolutionProposal {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  kind         String
  rationale    String // ليه النظام شايف إن ده يستاهل؟
  plan         Json // خطة التطبيق اللي هتنفذ عند الموافقة ({ action: "config"|"noop", patch: {...} })
  impact       String? // الأثر المتوقع بالأرقام/الكلام
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  decisionNote String?
  decidedAt    DateTime?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

/// حسابات المنصات المتعددة (طلب: تهيئة multi-account) — كل حساب = كوتية يومية إضافية
/// التوزيع تلقائي بالحِمل عبر pickAccount — الحالة WARMING بتمنع الإرسال لحد ما الحساب يتعير
model PlatformAccount {
  id            String    @id @default(cuid())
  workspaceId   String
  platform      String    // WHATSAPP | FACEBOOK | INSTAGRAM | TELEGRAM | LINKEDIN | X
  handle        String
  label         String?
  status        String    @default("WARMING") // WARMING | ACTIVE | COOLDOWN | BLOCKED | DISABLED
  dailyLimit    Int       @default(20)
  sentToday     Int       @default(0)
  lastSentAt    DateTime?
  cooldownUntil DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId, platform, status])
}

// ═══ Dynamic Skill Intelligence Layer — طبقة الذكاء الديناميكية (مواصفة 43) ═══
// TaskGraph: خريطة تفكير ديناميكية تُبنى لكل مهمة — مش خطة ثابتة. العقد تتنفذ بالترتيب
// القانوني (dependencies + priority) وتتأكد بالأدلة، وفشل أي مسار = إعادة تخطيط مش موت.
model TaskGraph {
  id          String    @id @default(cuid())
  workspaceId String
  goal        String // الهدف الأصلي للمهمة
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED | FAILED | STOPPED
  trigger     String    @default("AGENT") // AGENT | TOOL | TICK | API | CHAT
  sourceRunId String? // AgentRun المرتبط (لو جاية من الأيجنت)
  assumptions Json? // افتراضات البناء المسجلة عند الإنشاء
  facts       Json? // الحقايق الحالية (نتايج العقد المنفذة) — أساس اختيار الـroute
  finalResult Json? // النتيجة النهائية + ملخص الوعي (43.16)
  stats       Json? // عدادات: عقد منفذة/فاشلة/إعادة تخطيط/مهارات مستخدمة
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     TaskGraphNode[]
  events    TaskGraphEvent[]

  @@index([workspaceId, status])
  @@index([updatedAt])
}

// TaskGraphNode: عقدة واحدة بعقد التنفيذ الكامل (43.4) — الحواف جوه dependencies
// (معرفات العقد الواردة) و nextRoutes (مخرجات محتملة) — جدول حواف منفصل مش محتاج.
model TaskGraphNode {
  id                   String    @id @default(cuid())
  graphId              String
  graph                TaskGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  nodeId               String // N1, N2...
  parentNodeId         String?
  type                 String // OBSERVE | ANALYZE | PLAN | RETRIEVE_SKILLS | DISCOVER | VERIFY | ENRICH | QUALIFY | SCORE | RESEARCH | DECIDE | CONTACT | FOLLOWUP | LEARN | RECOVER | HUMAN_REVIEW | END
  objective            String // «إيه المطلوب من العقدة دي بالظبط»
  inputRequirements    Json? // مدخلات لازم تكون جاهزة
  requiredFacts        Json? // حقايق لازم تكون متوفرة قبل التنفيذ
  requiredSkills       Json? // القدرات المطلوبة نظريًا
  candidateSkills      Json? // مرشحو الاسترجاع (المرحلتان 2-4)
  selectedSkills       Json? // المختارون فعليًا مع provenance + selectionReason (43.10)
  tools                Json? // أدوات التنفيذ المسماة
  dependencies         Json? // [nodeId...] = الحواف الواردة
  priority             Int       @default(5)
  costEstimate         Int       @default(1) // 1-5
  riskEstimate         Int       @default(1) // 1-5
  expectedOutput       String?
  verificationCriteria Json? // معايير إثبات النجاح (43.5 VERIFY)
  policyGate           String    @default("STANDARD") // STANDARD | STRICT | HUMAN_APPROVAL
  accountRequirement   Json? // متطلبات حساب/جلسة
  sourceRequirement    Json? // متطلبات مصدر/منصة
  status               String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED | BLOCKED | SKIPPED
  attempts             Int       @default(0)
  outcome              String? // SUCCESS | INSUFFICIENT_EVIDENCE | MISSING_CAPABILITY | SOURCE_FAILURE | ACCOUNT_FAILURE | AUTH_REQUIRED | POLICY_BLOCK | PARTIAL
  outcomeData          Json? // الأدلة الفعلية (عدّادات/معرفات)
  failureReason        String?
  nextRoutes           Json? // مسارات محتملة بعد النتيجة
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([graphId, nodeId])
  @@index([graphId, status])
}

// TaskGraphEvent: سجل القرارات والأدلة وإعادة التخطيط والبوابات — كل «ليه عملت كده»
// بيتسجل هنا عشان الـAI يقدر يجاوب أسئلة الوعي (43.16) في أي لحظة.
model TaskGraphEvent {
  id        String    @id @default(cuid())
  graphId   String
  graph     TaskGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  nodeId    String?
  type      String // DECISION | EVIDENCE | REPLAN | GATE | SKILL_SELECTED | SKILL_OUTCOME | ERROR | SUMMARY
  message   String
  payload   Json?
  createdAt DateTime  @default(now())

  @@index([graphId, createdAt])
}

// SkillRetrieval: سجل كل عملية استرجاع مهارات من المكتبات — المرشحون بدرجاتهم
// والمختارون بأسبابهم والمرفوضون بسببهم (43.7 المراحل الخمس + منشأ 43.10).
model SkillRetrieval {
  id          String   @id @default(cuid())
  workspaceId String
  graphId     String?
  nodeId      String?
  taskId      String?
  objective   String   @default("") // هدف العقدة المطلوب الاسترجاع لعشانuه
  parsed      Json? // المرحلة 1: domain/action/platform/constraints...
  candidates  Json? // المراحل 2-4: المرشحون مع الدرجات المكونية
  selected    Json? // المرحلة 5: المختارون مع selectionReason
  rejected    Json? // المرفوضون بسببهم (ثقة/صلة/تكرار/سياسة)
  reason      String? // ملخص سبب الاختيار
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([graphId])
}

// SkillOutcome: نتيجة تنفيذ مهارة في عقدة — وقود حلقة التعلم (43.11/43.27):
// المهارة اللي بتنجح بترفع utility خاص بيها والفاشلة بتنزل في الترتيب الجاي.
model SkillOutcome {
  id          String   @id @default(cuid())
  workspaceId String
  skillKind   String // CORE | GITSKILLS | CLAWHUB | WORKSPACE
  skillKey    String // معرف فريد: اسم/مسار المهارة
  graphId     String?
  nodeId      String?
  taskId      String?
  outcome     String // SUCCESS | PARTIAL | FAILURE | UNKNOWN
  quality     Float    @default(0) // 0-100
  latencyMs   Int      @default(0)
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([skillKind, skillKey])
  @@index([workspaceId, createdAt])
}

// LeadOS — تصدير الليدز CSV (تخزين قاعدي بدل الملفات المحلية)
model LeadExport {
  id          String   @id @default(cuid())
  workspaceId String
  token       String   @unique @default(cuid())
  filename    String
  csv         String
  leadCount   Int      @default(0)
  minScore    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ═══ طبقة مهارات الورشة (Workspace Skills — 43.12) ═══
// مهارات خاصة بالورشة يضيفها المستخدم/الـAI بموافقة — تمر بوابة الثقة كاملة،
// وتوفر معرفة/استراتيجية فقط (لا تنفيذ كود أبدًا). الأولوية: CORE > WORKSPACE > CLAWHUB > GITSKILLS.
model WorkspaceSkill {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  description  String    @default("")
  body         String
  tags         String    @default("") // مفصولة بفواصل
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | REJECTED
  sourceRef    String    @default("manual") // manual | ai-proposal | import:...
  license      String    @default("")
  version      Int       @default(1)
  contentHash  String    @default("") // بصمة المحتوى — تغييرها = إعادة فحص الثقة (43.18)
  trustScore   Int       @default(0) // 0-100 من بوابة الثقة (43.8)
  rejectReason String?   // سبب الرفض لو البوابة رفضت (43.28 #19)
  weight       Float     @default(1.0)
  useCount     Int       @default(0)
  leadCount    Int       @default(0)
  activatedAt  DateTime?
  createdBy    String?   // userId لو دخول يدوي
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status, updatedAt])
}

// حالة النظام الرسمية (سجل واحد) — STOP end-to-end مع الأدلة الكاملة (Final Hardening #5)
model SystemState {
  id        String   @id @default(cuid()) // "singleton"
  state     String   @default("RUNNING") // RUNNING | STOPPING | STOPPED | DEGRADED
  reason    String?
  stoppedAt DateTime?
  stoppedBy String?
  resumedAt DateTime?
  resumedBy String?
  updatedAt DateTime @updatedAt
}
